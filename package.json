{
  "name": "govassist",
  "version": "1.0.0",
  "description": "AI-powered CLI assistant for Indian government employees",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "govassist": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "ai",
    "rag",
    "government",
    "chatbot",
    "cli",
    "nodejs",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.8.0",
    "better-sqlite3": "^12.2.0",
    "chalk": "^5.6.0",
    "commander": "^14.0.0",
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.6.0",
    "mammoth": "^1.10.0",
    "ora": "^8.2.0",
    "pino": "^9.9.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
